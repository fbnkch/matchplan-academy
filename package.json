{
  "name": "matchplan-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "hosting:prepare": "npm run build && node scripts/package-hosting.mjs",
    "hosting:vercel": "npm run build && node scripts/package-vercel.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "verify:examples": "python scripts/verify-example-projects.py",
    "test:watch": "vitest",
    "predev": "node scripts/prepare-runtime.mjs",
    "prebuild": "node scripts/prepare-runtime.mjs",
    "pretest": "node scripts/prepare-runtime.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "codemirror": "6.0.2",
    "fflate": "0.8.3",
    "pyodide": "314.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "description": "A project-led football analytics learning platform with browser Python/SQL exercises and downloadable IDE workshops.",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fbnkch/matchplan-academy.git"
  }
}
